# Ktown Auto Spa Server & Payment Configuration

# Server Port
PORT=5001

# Stripe API Keys (Get these from your Stripe Dashboard: https://dashboard.stripe.com/apikeys)
# 1. Stripe Secret Key (e.g. sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# 2. Stripe Webhook Secret (e.g. whsec_... from Webhooks section)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# 3. Client Publishable Key for Frontend (e.g. pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Shop Notification Email
SHOP_EMAIL=ktownautomobilespa@gmail.com
