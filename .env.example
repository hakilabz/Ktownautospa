# Ktown Auto Spa Server & Payment Configuration

# Server Port
PORT=5001

# ========================================================
# 1. Stripe API Keys
# From your open Stripe Dashboard: https://dashboard.stripe.com/acct_1TZaQHH2HWn2i39m/apikeys
# ========================================================
# Secret Key (e.g. sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Publishable Key for Frontend (e.g. pk_live_... or pk_test_...)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Webhook Signing Secret (Optional, from https://dashboard.stripe.com/webhooks)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ========================================================
# 2. Shop Notification Emails
# Dispatches booking alerts to both emails automatically
# ========================================================
SHOP_NOTIFICATION_EMAILS=ktownautomobilespa@gmail.com,gud4notin@hotmail.com

# Web3Forms Access Key (Dual-recipient fallback)
WEB3FORMS_ACCESS_KEY=2e1c3132-7a7a-4c2c-80a5-f8510800fa26

# ========================================================
# 3. Optional SMTP Configuration (Direct Transactional Email)
# For automated customer confirmation and owner alerts
# ========================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ktownautomobilespa@gmail.com
# SMTP_PASS=your_gmail_app_password
