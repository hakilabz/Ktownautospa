# K-Town Auto Spa Server & Payment Configuration

# Server Port
PORT=5001

# ========================================================
# 1. Stripe API Keys
# From your Stripe Dashboard: https://dashboard.stripe.com/apikeys
# ========================================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ========================================================
# 2. Shop Notification Emails
# Dispatches booking alerts to both owner emails + customer confirmation
# ========================================================
SHOP_NOTIFICATION_EMAILS=ktownautomobilespa@gmail.com,gud4notin@hotmail.com

# ========================================================
# 3. Outgoing Email Configuration (Customer & Owner Emails)
# Option A: Gmail App Password (https://myaccount.google.com/apppasswords)
# You can also set this live inside the Owner Admin Portal -> Email & Alerts
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ktownautomobilespa@gmail.com
SMTP_PASS=

# Option B: Resend API Key (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="K-Town Auto Spa <bookings@ktownautospa.ca>"
